# ==========================================
# DevElevate - Environment Variables
# ==========================================

# ========= SERVER (.env) =========
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dev-elevate

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
SECRET_KEY=your_admin_secret_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# OpenAI (AI features, assessments)
OPENAI_API_KEY=your_openai_api_key
OPENAI_ASSESSMENT_MODEL=gpt-4o-mini

# Gemini AI (chat assistant)
GEMINI_API_KEY=your_gemini_api_key

# YouTube API (video metadata)
YOUTUBE_API_KEY=your_youtube_api_key

# News API (tech news aggregation)
NEWS_API_KEY=your_news_api_key

# Judge0 (code compilation)
JUDGE0_API_KEY=your_judge0_api_key
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# RapidAPI (compiler routes)
RAPID_API_KEY=your_rapidapi_key

# Email (Nodemailer)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# ========= CLIENT (.env) =========
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# GROQ AI (client-side)
VITE_GROQ_API_KEY=your_groq_api_key

# Gemini (client-side)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id